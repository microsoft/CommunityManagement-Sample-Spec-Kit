{
  "name": "@acroyoga/shared-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": {
      "react-native": "./src/*/index.native.tsx",
      "default": "./src/*/index.web.tsx"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:a11y": "vitest run --reporter verbose"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vitest-axe": "^0.1.0"
  }
}
